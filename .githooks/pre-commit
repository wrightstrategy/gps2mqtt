#!/usr/bin/env bash
# ws:gitleaks begin — generated by bridge repo-bootstrap; do not hand-edit
# Pinned, checksum-verified gitleaks scan of the changes being committed. Host git resolves
# worktrees and the temporary index of `git commit -a`; any failure blocks the commit.
ws_gitleaks_version=8.30.1
case "$(uname -s)_$(uname -m)" in
  Darwin_arm64) ws_gitleaks_asset=darwin_arm64 ws_gitleaks_sha256=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5 ;;
  Darwin_x86_64) ws_gitleaks_asset=darwin_x64 ws_gitleaks_sha256=dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709 ;;
  Linux_aarch64 | Linux_arm64) ws_gitleaks_asset=linux_arm64 ws_gitleaks_sha256=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080 ;;
  Linux_x86_64) ws_gitleaks_asset=linux_x64 ws_gitleaks_sha256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb ;;
  *) echo "pre-commit: no pinned gitleaks build for $(uname -sm); commit blocked" >&2; exit 1 ;;
esac
ws_gitleaks_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/wrightstrategy/gitleaks/${ws_gitleaks_version}-${ws_gitleaks_asset}"
ws_gitleaks_bin="${ws_gitleaks_dir}/gitleaks"
if [ ! -x "${ws_gitleaks_bin}" ]; then
  # First use on this machine: fetch the release tarball, verify it, then rename into place
  # (the staging directory sits beside the cache entry, so the rename is atomic).
  ws_gitleaks_tarball="gitleaks_${ws_gitleaks_version}_${ws_gitleaks_asset}.tar.gz"
  echo "pre-commit: fetching pinned gitleaks ${ws_gitleaks_version} (first use on this machine)" >&2
  if ! mkdir -p "${ws_gitleaks_dir}" || ! ws_gitleaks_tmp="$(mktemp -d "${ws_gitleaks_dir}/.fetch.XXXXXX")"; then
    echo "pre-commit: cannot create ${ws_gitleaks_dir}; commit blocked" >&2; exit 1
  fi
  if ! curl -fsSL --retry 2 -o "${ws_gitleaks_tmp}/${ws_gitleaks_tarball}" \
    "https://github.com/gitleaks/gitleaks/releases/download/v${ws_gitleaks_version}/${ws_gitleaks_tarball}"; then
    rm -rf "${ws_gitleaks_tmp}"; echo "pre-commit: gitleaks download failed; commit blocked" >&2; exit 1
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    ws_gitleaks_got="$(sha256sum "${ws_gitleaks_tmp}/${ws_gitleaks_tarball}" | cut -d ' ' -f 1)"
  else
    ws_gitleaks_got="$(shasum -a 256 "${ws_gitleaks_tmp}/${ws_gitleaks_tarball}" | cut -d ' ' -f 1)"
  fi
  if [ "${ws_gitleaks_got}" != "${ws_gitleaks_sha256}" ]; then
    rm -rf "${ws_gitleaks_tmp}"
    echo "pre-commit: gitleaks checksum mismatch (expected ${ws_gitleaks_sha256}, got ${ws_gitleaks_got}); commit blocked" >&2
    exit 1
  fi
  if ! tar -xzf "${ws_gitleaks_tmp}/${ws_gitleaks_tarball}" -C "${ws_gitleaks_tmp}" gitleaks ||
    ! chmod 755 "${ws_gitleaks_tmp}/gitleaks" || ! mv -f "${ws_gitleaks_tmp}/gitleaks" "${ws_gitleaks_bin}"; then
    rm -rf "${ws_gitleaks_tmp}"; echo "pre-commit: gitleaks install failed; commit blocked" >&2; exit 1
  fi
  rm -rf "${ws_gitleaks_tmp}"
fi
if ws_gitleaks_log="$("${ws_gitleaks_bin}" git --pre-commit --staged --redact --verbose --no-banner --no-color 2>&1)"; then
  ws_gitleaks_rc=0
else
  ws_gitleaks_rc=$?
fi
printf '%s\n' "${ws_gitleaks_log}" >&2
if [ "${ws_gitleaks_rc}" -ne 0 ]; then
  echo "pre-commit: gitleaks blocked this commit (exit ${ws_gitleaks_rc})" >&2; exit 1
fi
# gitleaks logs git failures (e.g. a failing diff driver) as ERR yet exits 0: the scan was partial.
if printf '%s\n' "${ws_gitleaks_log}" | grep -Eq '^[^ ]+ ERR '; then
  echo "pre-commit: gitleaks reported an error, so the scan may be incomplete; commit blocked" >&2; exit 1
fi
# ws:gitleaks end
